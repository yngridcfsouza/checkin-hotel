generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(GUEST) // GUEST, HOTEL, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guest   Guest?
  guestId String?
  hotel   Hotel?
  hotelId String?
}

model Guest {
  id        String    @id @default(cuid())
  cpf       String    @unique
  birthDate DateTime
  phone     String
  user      User      @relation(fields: [userId], references: [id])
  userId    String    @unique
  checkins  Checkin[]
}

model Hotel {
  id       String    @id @default(cuid())
  cnpj     String    @unique
  address  String
  phone    String
  user     User      @relation(fields: [userId], references: [id])
  userId   String    @unique
  checkins Checkin[]
}

model Checkin {
  id        String        @id @default(cuid())
  guest     Guest         @relation(fields: [guestId], references: [id])
  guestId   String
  hotel     Hotel         @relation(fields: [hotelId], references: [id])
  hotelId   String
  status    CheckinStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum Role {
  GUEST
  HOTEL
  ADMIN
}

enum CheckinStatus {
  PENDING
  CONFIRMED
  REJECTED
}
